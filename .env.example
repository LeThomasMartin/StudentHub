# Copy this file to .env locally. Never commit the real .env.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/studenthub?schema=public"

# Configure this path on the desktop that hosts StudentHub and PostgreSQL.
STUDENTHUB_STORAGE_ROOT="D:\StudentHubData"

# The server launcher only accepts loopback or a Tailscale IPv4 address.
# Set this to the desktop's current Tailscale IPv4 to allow tailnet access.
STUDENTHUB_BIND_HOST=127.0.0.1
STUDENTHUB_PORT=3000
